<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F8FC"
    tools:context=".Fragment2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your information"
            android:textColor="#292B45"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tell us a little about yourself"
            android:textColor="#74768A"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Full name *"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="54dp"
            android:padding="12dp"
            android:backgroundTint="#7777C8" />

        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:minHeight="54dp"
            android:padding="12dp"
            android:backgroundTint="#7777C8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gender"
            android:textColor="#55566B"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_gender"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/edit_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Age (optional)"
            android:inputType="number"
            android:minHeight="54dp"
            android:padding="12dp"
            android:backgroundTint="#7777C8" />

        <EditText
            android:id="@+id/edit_university"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="University (optional)"
            android:inputType="textCapWords"
            android:minHeight="54dp"
            android:padding="12dp"
            android:backgroundTint="#7777C8" />

        <Button
            android:id="@+id/button_fragment2_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Continue"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
